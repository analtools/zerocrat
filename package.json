{
  "name": "@analtools/zerocrat",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/analtools/zerocrat.git"
  },
  "bugs": {
    "url": "https://github.com/analtools/zerocrat/issues"
  },
  "homepage": "https://github.com/analtools/zerocrat#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/node-fetch": "^2.6.13",
    "@vitest/coverage-v8": "^4.1.10",
    "coverage-badges-cli": "^2.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "prettier:check": "prettier '**/*.{svg,yml,js,jsx,ts,tsx,html,md,css,json}' --check",
    "prettier": "prettier '**/*.{svg,yml,js,jsx,ts,tsx,html,md,css,json}' --write",
    "lint": "eslint --quiet .",
    "lint:fix": "eslint --fix --quiet .",
    "test:unit": "vitest --config vitest.config.unit.mts run",
    "test:unit:coverage": "vitest --config vitest.config.unit.mts run --coverage && coverage-badges --output coverage/badge.svg",
    "prepare": "husky",
    "build": "yarn workspaces foreach --verbose --topological --all --interlaced --parallel run build",
    "postinstall": "yarn build"
  },
  "lint-staged": {
    "*.(ts|tsx|js|jsx|json|yml|md|mdx)": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "packages/sources/*"
  ]
}
